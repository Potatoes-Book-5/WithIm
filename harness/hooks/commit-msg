#!/usr/bin/env bash
# 커밋 메시지 형식 검사. 규칙은 docs/team/git-workflow.md 참고.
set -euo pipefail

msg_file=$1

fail() {
  echo "커밋 거부: $1" >&2
  echo "형식: <type>(<scope>): <summary>, 본문은 '- ' 항목, Refs: T-NNN" >&2
  echo "자세한 내용: docs/team/git-workflow.md" >&2
  exit 1
}

# git이 넣는 주석과 -v diff, 빈 줄을 제외한 실제 메시지
message=$(sed '/^# -* >8 -*$/,$d' "$msg_file" | grep -v '^#' | grep -v '^[[:space:]]*$' || true)
subject=${message%%$'\n'*}

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

grep -qE '^(feat|fix|docs|design|refactor|test|chore|harness)\([^)]+\): .+' <<< "$subject" \
  || fail "제목 형식이 맞지 않습니다: $subject"

if [ "$(printf '%s' "$subject" | wc -m | tr -d ' ')" -gt 72 ]; then
  fail "제목은 72자 이내여야 합니다."
fi

# Hangul 음절의 UTF-8 바이트 범위를 찾는다.
if LC_ALL=C grep -qE $'\xEA[\xB0-\xBF]|[\xEB\xEC][\x80-\xBF]|\xED[\x80-\x9E]' <<< "$message"; then
  fail "커밋 메시지는 영어로 작성해야 합니다."
fi

# 사람 공동 작업자는 허용하고 AI 표기만 거부한다.
if grep -qiE '^co-authored-by:.*(claude|anthropic|copilot|cursor|codex|gemini|chatgpt|openai)|generated (with|by) .*(claude|copilot|cursor|codex|gemini|chatgpt|ai([^a-z]|$))' <<< "$message"; then
  fail "AI 표기(Co-Authored-By, Generated with)는 커밋 메시지에 넣지 않습니다."
fi

# 제목 다음 줄부터는 '- ' 항목 또는 Refs: 같은 트레일러만 허용한다.
if [ "$message" != "$subject" ]; then
  body=${message#*$'\n'}
  if grep -qvE '^- .+|^[A-Za-z-]+: .+' <<< "$body"; then
    fail "본문은 '- '로 시작하는 항목을 한 줄에 하나씩 작성해야 합니다."
  fi
fi

case "$subject" in
  chore\(tracking\):*) exit 0 ;;
esac

grep -qE '^Refs:.*T-[0-9]{3}' <<< "$message" || fail "Refs: 줄에 T-ID가 없습니다."
