<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Pleos 권한(pleos.car.permission.*)은 실제로 쓰는 API의 최소 권한만 선언합니다.
        요구사항 확정 후 위치·TTS 등 사용 기능에 맞춰 추가합니다.
    -->
    <!-- FusedLocation 위치 수신(F-001, T-029). protection level dangerous라 SCR-006 동의 저장 후 런타임에 요청한다. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 기어 상태(AAOS GEAR_SELECTION, T-034). normal 보호 수준이라 런타임 요청이 없다. -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:name=".RealEstateApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KingOfRealEstate">
        <!-- CarUxRestrictionsManager(T-035). 차량이 아닌 기기에서도 설치되도록 선택 라이브러리로 둔다. -->
        <uses-library
            android:name="android.car"
            android:required="false" />
        <!-- 네이버 지도 Client ID(ADR-004). 값은 local.properties에서 빌드 때 채운다. -->
        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${naverMapClientId}" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!--
                주행 중에도 순위·지도 주행 화면(SCR-004, SCR-009)을 보여 주려고 DO를 선언한다(T-035, DR-001, 사용자 결정).
                화면이 한 액티비티라 앱이 규제 상태를 받아 주행 화면 외 기능을 직접 막는다(DI-002, AppState.showDriving·showParkFirst).
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
